# -----------------------------------------------------------------------------
# DATABASE & REDIS CONFIGURATION
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgear_db?schema=public"
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET="super-secret-jwt-token-key-change-in-production-min-32-chars"
ENCRYPTION_KEY_AES256="32-byte-hex-string-for-encrypting-oauth-tokens-at-rest"
NEXTAUTH_SECRET="next-auth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# OAUTH AUTHENTICATION PROVIDERS
GOOGLE_CLIENT_ID="google-client-id"
GOOGLE_CLIENT_SECRET="google-client-secret"
FACEBOOK_CLIENT_ID="facebook-client-id"
FACEBOOK_CLIENT_SECRET="facebook-client-secret"

# -----------------------------------------------------------------------------
# SOCIAL PLATFORM OAUTH & API KEYS (Sprint 3)
# -----------------------------------------------------------------------------
# Credentials for *publishing* to social channels. Every one is optional: leave
# a pair blank and that provider shows up disabled in the Channels page with a
# "not configured" reason, rather than disappearing — a missing key is a
# deployment gap, not an unsupported platform.
#
# Callback URL to register for each provider:
#   http://localhost:3001/channels/connect/<provider>/callback
# where <provider> is one of: x, linkedin, linkedin-page, facebook, instagram,
# youtube, tiktok, pinterest.

# X (Twitter) — OAuth 2.0 with PKCE. The app must request offline.access or no
# refresh token is issued and the channel dies at the first expiry.
X_TWITTER_CLIENT_ID="x-client-id"
X_TWITTER_CLIENT_SECRET="x-client-secret"

# Meta — Facebook Pages and Instagram Business share one app. This is a
# DIFFERENT app from FACEBOOK_CLIENT_* above, which is social login. Publishing
# scopes (pages_manage_posts, instagram_content_publish) need Meta app review;
# keeping them apart means a review problem here cannot break sign-in.
FACEBOOK_APP_ID="meta-app-id"
FACEBOOK_APP_SECRET="meta-app-secret"

# LinkedIn — one app serves both personal profiles and company pages. Refresh
# tokens are only issued to apps approved for the Marketing Developer Platform;
# without that, tokens last 60 days and then need a reconnect.
LINKEDIN_CLIENT_ID="linkedin-client-id"
LINKEDIN_CLIENT_SECRET="linkedin-client-secret"

# YouTube — a Google Cloud OAuth client with the YouTube Data API v3 enabled.
YOUTUBE_CLIENT_ID="youtube-client-id"
YOUTUBE_CLIENT_SECRET="youtube-client-secret"

# TikTok — note it is CLIENT_KEY, not client id, in every TikTok request. Until
# the app passes content-posting review, everything it publishes is forced
# private regardless of the requested privacy level.
TIKTOK_CLIENT_KEY="tiktok-client-key"
TIKTOK_CLIENT_SECRET="tiktok-client-secret"

# Pinterest — API v5. Trial apps are limited until Pinterest grants standard access.
PINTEREST_APP_ID="pinterest-app-id"
PINTEREST_APP_SECRET="pinterest-app-secret"

# -----------------------------------------------------------------------------
# AI ENGINE & SEARCH APIS (Sprint 6)
# -----------------------------------------------------------------------------
# How the API picks its AI mode, in order:
#   1. AI_SIMULATION="true"  -> simulation: no key, no bill. The model, the web
#      research and the images are deterministic stand-ins; credits, streaming,
#      tool calling and the media library are real. This is how the project is
#      tested locally (same idea as the worker's PUBLISH_SIMULATION). Refused
#      when NODE_ENV=production.
#   2. OPENAI_API_KEY set    -> openai: GPT for text, DALL-E for images.
#   3. neither               -> unconfigured: /ai/status reports it, the
#      generation routes answer 503, and the AI Copilot page explains.
# Leave a key empty rather than pasting a placeholder — the old example values
# (sk-proj-..., tvly-...) are recognised and ignored with a boot warning.
OPENAI_API_KEY=""
# Optional. With a key, every generation is backed by Tavily web research
# (results cached in Redis for 10 minutes so a retry does not pay twice).
# Without one, posts are written unresearched and the UI says so.
TAVILY_API_KEY=""
# Chat model for the pipeline and the copilot. Default: gpt-4.1-mini.
AI_MODEL=""
# Image model for hero images and the copilot's generate_image. Default: dall-e-3.
AI_IMAGE_MODEL=""
# "true" or "false" (default). See above.
AI_SIMULATION=""

# -----------------------------------------------------------------------------
# STRIPE MONETIZATION
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_stripe_webhook_signing_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_stripe_publishable_key"

# -----------------------------------------------------------------------------
# MEDIA STORAGE (Sprint 4)
# -----------------------------------------------------------------------------
# One switch picks where uploaded media lives:
#   local — files under UPLOAD_DIRECTORY, served by the API at <API_URL>/uploads.
#           The default; needs nothing else. Instagram, Facebook, Pinterest
#           and TikTok fetch media from its URL themselves, so localhost cannot
#           publish media to them — see docs/social-platform-setup.md.
#   s3    — any S3-compatible store: AWS S3, Cloudflare R2, or the MinIO in
#           docker-compose. The bucket must allow anonymous reads of objects.
STORAGE_PROVIDER="local"
# Absent means apps/api/uploads, whichever directory the API is started from.
# UPLOAD_DIRECTORY="/var/lib/postgear/uploads"

# Required together when STORAGE_PROVIDER=s3 (the API refuses to boot otherwise):
# S3_BUCKET_NAME, S3_ACCESS_KEY, S3_SECRET_KEY and S3_PUBLIC_URL.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET_NAME="postgear-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
# Where objects are publicly readable — for MinIO, the endpoint plus the bucket;
# for R2, the bucket's custom domain or r2.dev address; behind a CDN, the CDN.
S3_PUBLIC_URL="http://localhost:9000/postgear-media"
# MinIO needs path-style addressing. Leave unset to use it whenever S3_ENDPOINT is set.
# S3_FORCE_PATH_STYLE="true"

# -----------------------------------------------------------------------------
# SCHEDULER (Sprint 5) — Temporal, from docker-compose
# -----------------------------------------------------------------------------
# The API starts and signals publish workflows here; the worker (`npm run
# dev:worker`) runs them. Both read these two variables. The Temporal web UI is
# at http://localhost:8233.
TEMPORAL_HOST="localhost:7233"
TEMPORAL_NAMESPACE="default"

# How many posts one worker process publishes at the same time.
WORKER_MAX_CONCURRENT_PUBLISHES=5

# Publish to a stand-in instead of real platforms. For local development and
# the end-to-end suite: the seeded channels hold fake tokens that every platform
# would reject. Timers, retries, status and the refresh branch all run for real;
# only the final call is replaced. Write `[simulate:429]`, `[simulate:429x2]`,
# `[simulate:401]`, `[simulate:400]` or `[simulate:slow:5]` in a post to make
# the stand-in fail or stall on purpose. Refused when NODE_ENV=production.
PUBLISH_SIMULATION="false"

# -----------------------------------------------------------------------------
# API SERVER (Sprint 2)
# -----------------------------------------------------------------------------
# The API runs on a different port from the web app but the SAME host. Cookies
# are scoped by host, not port, so the httpOnly session cookie the API sets is
# sent back from pages served on :3000 without any proxying.
PORT=3001
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
JWT_EXPIRES_IN="7d"
AUTH_COOKIE_NAME="pg_session"
ORG_COOKIE_NAME="pg_org"

# Rate limiting & account lockout. The per-IP throttle is Redis-backed; the
# account lockout lives on the User row in Postgres so a Redis restart cannot
# clear it.
LOGIN_RATE_LIMIT_PER_MIN=10
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Email. Leave SMTP_HOST empty to print mail (including activation and reset
# links) to the API console instead of sending it — the local default.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PostGear <no-reply@postgear.local>"
