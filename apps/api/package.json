{
  "name": "@postgear/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/apps/api/src/main.js",
    "lint": "biome lint ./src",
    "lint:fix": "biome check --write ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@postgear/ai-engine": "*",
    "@postgear/automation": "*",
    "@postgear/db": "*",
    "@postgear/design-engine": "*",
    "@postgear/seo-engine": "*",
    "@postgear/social-core": "*",
    "@sentry/nestjs": "^11.8.0",
    "@temporalio/client": "^1.24.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "fflate": "^0.8.3",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "stripe": "^23.0.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.0",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
