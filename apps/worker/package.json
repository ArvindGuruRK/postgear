{
  "name": "@postgear/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/apps/worker/src/index.js",
    "lint": "biome lint ./src",
    "lint:fix": "biome check --write ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@postgear/ai-engine": "*",
    "@postgear/automation": "*",
    "@postgear/db": "*",
    "@postgear/scheduling": "*",
    "@postgear/seo-engine": "*",
    "@postgear/social-core": "*",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.24.0",
    "@types/node": "^20.0.0",
    "dotenv-cli": "^7.4.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
