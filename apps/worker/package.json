{
  "name": "@postgear/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "biome lint ./src",
    "lint:fix": "biome check --write ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@postgear/db": "*",
    "@postgear/social-core": "*",
    "@postgear/seo-engine": "*",
    "@postgear/ai-engine": "*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "ts-node-dev": "^2.0.0"
  }
}
