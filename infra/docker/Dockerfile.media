# syntax=docker/dockerfile:1.7
#
# PostGear media image (Sprint 13, Module 01): the Python media service
# (apps/media), FastAPI on 8100 and a Temporal worker on postgear-media-py.
#
#   docker build -f infra/docker/Dockerfile.media -t postgear-media:local .
#   docker build -f infra/docker/Dockerfile.media --build-arg GROUPS=ml -t postgear-media:ml .
#
# Two variants from one file:
# - slim (the default): the base packages only. Enough for MEDIA_SIMULATION,
#   which answers every activity from recorded files. No model library.
# - full (`--build-arg GROUPS=ml`): adds the `ml` dependency group (speech to
#   text, faces, motion). No PyTorch, no graphics card libraries.
#
# Model files are never in the image: MEDIA_MODEL_DIR is a volume, filled once
# at deploy (Module 15). The image runs as a non-root user and needs only the
# scratch and model volumes to be writable.
#
# The uv recipe is the one in uv's Docker guide: the pinned uv binary copied
# in, dependencies synced from the lockfile alone as their own layer, then the
# project, then only the finished .venv copied into the final stage.

ARG PYTHON_IMAGE=python:3.13-slim-bookworm
ARG UV_VERSION=0.13.10

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ${PYTHON_IMAGE} AS build
ARG GROUPS=""
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PYTHON_DOWNLOADS=0
COPY --from=uv /uv /uvx /bin/
WORKDIR /app/apps/media

# Dependencies first: this layer changes only when the lockfile does.
COPY apps/media/pyproject.toml apps/media/uv.lock apps/media/.python-version apps/media/README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project ${GROUPS:+--group ${GROUPS}}

COPY apps/media/src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked ${GROUPS:+--group ${GROUPS}}

FROM ${PYTHON_IMAGE} AS runtime
# tini reaps anything a library starts; curl is the health check's only tool.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10002 postgear \
 && useradd --uid 10002 --gid 10002 --create-home --shell /usr/sbin/nologin postgear \
 && install -d -o postgear -g postgear /var/lib/postgear/media-scratch /var/lib/postgear/media-models

WORKDIR /app/apps/media
COPY --from=build --chown=postgear:postgear /app/apps/media/.venv ./.venv
COPY --from=build --chown=postgear:postgear /app/apps/media/src ./src
# The recorded answers MEDIA_SIMULATION reads are part of the package (src/postgear_media/simulation).

ENV PATH="/app/apps/media/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NODE_ENV=production \
    MEDIA_URL=http://0.0.0.0:8100 \
    MEDIA_SCRATCH_DIR=/var/lib/postgear/media-scratch \
    MEDIA_MODEL_DIR=/var/lib/postgear/media-models

VOLUME ["/var/lib/postgear/media-scratch", "/var/lib/postgear/media-models"]
USER postgear
EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8100/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "postgear_media.main:app", "--host", "0.0.0.0", "--port", "8100", "--no-access-log"]
