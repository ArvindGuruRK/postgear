{
  "name": "postgear",
  "version": "0.0.1",
  "private": true,
  "description": "PostGear — AI-Powered Social Media Management & SEO Platform",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "test:coverage": "turbo run test:coverage",
    "validate": "turbo run lint typecheck test",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "db:studio": "npm run studio --workspace=packages/db",
    "db:reset": "npm run migrate:reset --workspace=packages/db",
    "generate:keys": "ts-node --project scripts/tsconfig.json scripts/generate-keys.ts",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:e2e": "dotenv -e .env -- playwright test",
    "test:e2e:ui": "dotenv -e .env -- playwright test --ui",
    "dev:api": "npm run dev --workspace=@postgear/api",
    "dev:api:e2e": "dotenv -e .env -v LOGIN_RATE_LIMIT_PER_MIN=500 -v LOCKOUT_THRESHOLD=50 -- ts-node-dev --respawn --transpile-only --project apps/api/tsconfig.json apps/api/src/main.ts",
    "audit:passwords": "dotenv -e .env -- ts-node --project scripts/tsconfig.json scripts/audit-password-hashes.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
