generator client {
  provider = "prisma-client-js"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  description         String?
  apiKey              String?
  paymentId           String?
  streakSince         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  allowTrial          Boolean              @default(false)
  isTrailing          Boolean              @default(false)
  shortlink           ShortLinkPreference  @default(ASK)
  // Home dashboard (2026-10-19): how many posts a week the workspace aims to
  // publish. Null means "not set", and the dashboard derives a default from
  // the creator's onboarding answer to "How often do you post on social media?".
  weeklyPostGoal      Int?
  Comments            Comments[]
  credits             Credits[]
  customers           Customer[]
  errors              Errors[]
  Integration         Integration[]
  media               Media[]
  notifications       Notifications[]
  post                Post[]
  sets                Sets[]
  signatures          Signatures[]
  subscription        Subscription?
  tags                Tags[]
  users               UserOrganization[]
  webhooks            Webhooks[]
  oauthApp            OAuthApp[]
  oauthAuthorizations OAuthAuthorization[]
  // Sprint 7
  channelMetrics      ChannelMetricSnapshot[]
  postMetrics         PostMetricSnapshot[]
  analyticsSyncs      AnalyticsSync[]
  seoAudits           SEOAudit[]
  // Sprint 8
  notificationCursors NotificationCursor[]
  apiKeys             ApiKey[]
  webhookDeliveries   WebhookDelivery[]
  billingEvents       BillingEvent[]
  // Sprint 9
  brandKits           BrandKit[]
  designs             Design[]
  designFavourites    DesignFavourite[]
  // Sprint 10
  automations         Automation[]
  automationRuns      AutomationRun[]
  automationConnections AutomationConnection[]

  @@index([apiKey])
  @@index([streakSince])
  @@index([paymentId])
}

model Tags {
  id           String       @id @default(uuid())
  name         String
  color        String
  orgId        String
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  posts        TagsPosts[]

  @@index([orgId])
  @@index([deletedAt])
}

model TagsPosts {
  postId    String
  tagId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id])
  tag       Tags     @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
  @@unique([postId, tagId])
}

model User {
  id                    String               @id @default(uuid())
  email                 String
  password              String?
  providerName          Provider
  name                  String?
  lastName              String?
  isSuperAdmin          Boolean              @default(false)
  bio                   String?
  audience              Int                  @default(0)
  pictureId             String?
  providerId            String?
  timezone              Int
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  lastReadNotifications DateTime             @default(now())
  inviteId              String?
  activated             Boolean              @default(true)
  account               String?
  connectedAccount      Boolean              @default(false)
  lastOnline            DateTime             @default(now())
  ip                    String?
  agent                 String?
  comments              Comments[]
  picture               Media?               @relation(fields: [pictureId], references: [id])
  organizations         UserOrganization[]
  sendSuccessEmails     Boolean              @default(true)
  sendFailureEmails     Boolean              @default(true)
  sendStreakEmails      Boolean              @default(true)
  oauthAuthorizations   OAuthAuthorization[]
  // Sprint 8: where this user has read up to, per workspace.
  notificationCursors   NotificationCursor[]
  // Sprint 9: what this user made in Studio.
  brandKits             BrandKit[]           @relation("BrandKitAuthor")
  designs               Design[]             @relation("DesignAuthor")
  designShares          DesignShare[]        @relation("DesignShareAuthor")
  designFavourites      DesignFavourite[]    @relation("DesignFavouriteAuthor")
  // Sprint 10: the workflows this user made, edited, turned on or ran.
  automationsCreated    Automation[]         @relation("AutomationAuthor")
  automationsUpdated    Automation[]         @relation("AutomationEditor")
  automationVersions    AutomationVersion[]  @relation("AutomationVersionAuthor")
  automationRuns        AutomationRun[]      @relation("AutomationRunStarter")
  automationConnectionsCreated AutomationConnection[] @relation("AutomationConnectionAuthor")
  automationConnectionsUpdated AutomationConnection[] @relation("AutomationConnectionEditor")

  // --- Sprint 2: auth lifecycle -------------------------------------------
  // Tokens are stored as SHA-256 hashes, never as the value mailed to the
  // user. A database leak therefore yields no usable activation or reset
  // link. Compare with `safeCompare()` from packages/db/src/crypto.ts.
  activationTokenHash         String?   @unique
  activationTokenExpiresAt    DateTime?
  passwordResetTokenHash      String?   @unique
  passwordResetTokenExpiresAt DateTime?
  passwordChangedAt           DateTime?

  // Account lockout lives in Postgres rather than Redis on purpose: a Redis
  // restart or eviction must not be a lockout bypass. The per-IP request
  // throttle is the ephemeral half and does live in Redis.
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?

  // --- Sprint 2: onboarding ------------------------------------------------
  // `onboardingStep` is 1-based and matches OnboardingStepper's `currentStep`.
  // It exists so an abandoned flow resumes where it stopped; a derived
  // "has >= 1 UserOrganization" check cannot express that, because creating
  // the workspace is only step 1 of 5.
  onboardingStep        Int                 @default(1)
  onboardingCompletedAt DateTime?
  onboarding            OnboardingResponse?

  // --- UI revamp (2026-10-17): appearance and avatar -----------------------
  // Per user, not per workspace: how the app looks is a personal choice that
  // follows the person across devices and workspaces. `lightTheme` and
  // `darkTheme` are ids from the theme catalog
  // (apps/api/src/modules/users/appearance.catalog.ts), one per scheme: the
  // light one applies while the effective mode is light, the dark one while it
  // is dark, and both are kept across a switch. A premium id stays stored if a
  // plan lapses, but is served back as `classic` (the default in both modes)
  // until the user is entitled again.
  themeMode  ThemeMode @default(SYSTEM)
  lightTheme String    @default("classic")
  darkTheme  String    @default("classic")
  // At most one of these is set; choosing one clears the other. A preset is
  // an id into the bundled avatar set; `avatarUrl` is an uploaded image (or
  // the OAuth provider's photo, re-hosted at signup) on our own storage.
  avatarPreset String?
  avatarUrl    String?

  @@unique([email, providerName])
  @@index([lastReadNotifications])
  @@index([inviteId])
  @@index([account])
  @@index([lastOnline])
  @@index([pictureId])
  @@index([lockedUntil])
}

/// The five onboarding survey answers, one row per user.
///
/// Deliberately NOT tenant-scoped: these are collected before the workspace
/// exists (step 1 creates it, steps 2-5 run after), so the row keys on
/// `userId`. Every answer column is nullable so a half-finished flow persists
/// rather than being all-or-nothing.
model OnboardingResponse {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id])
  role               OnboardingRole?
  teamSize           OnboardingTeamSize?
  primaryGoal        OnboardingGoal?
  postingFrequency   PostingFrequency?
  referralSource     ReferralSource?
  /// Platforms the user said they intend to post to, captured on the channel
  /// step. Free-form strings rather than an enum because the channel list is
  /// Sprint 3's to define and will grow.
  interestedChannels String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model UserOrganization {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  disabled       Boolean      @default(false)
  role           Role         @default(USER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
  @@index([disabled])
}

/// An uploaded image or video in a workspace's media library (Sprint 4).
///
/// `path` and `thumbnail` are **storage keys** (`2026/09/<hex>.jpg`), not URLs.
/// The public URL is built at read time by the configured storage backend, so
/// moving from local disk to S3, or changing the API's public address, does not
/// orphan every row. `fileSize` is the size *after* compression.
model Media {
  id                 String              @id @default(uuid())
  name               String
  originalName       String?
  path               String
  organizationId     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  fileSize           Int                 @default(0)
  type               String              @default("image")
  thumbnail          String?
  alt                String?
  thumbnailTimestamp Int?
  // --- Sprint 4: what platform rules need to know --------------------------
  // Recorded at upload so the composer can enforce Instagram's JPEG-only and
  // 4:5–1.91:1 rules, and render previews at the right shape, without
  // downloading the file again. Nullable: rows from before this migration have
  // none, and every rule that reads them skips when a value is unknown.
  mimeType           String?
  width              Int?
  height             Int?
  organization       Organization        @relation(fields: [organizationId], references: [id])
  userPicture        User[]
  oauthApps          OAuthApp[]
  // Sprint 9: a brand kit's logo. Exported slides are ordinary Media rows and
  // need no relation: `Design.exportedMediaIds` holds their ids in order.
  brandKitLogos      BrandKit[]          @relation("BrandKitLogo")

  @@index([name])
  @@index([organizationId])
  @@index([type])
}

model Credits {
  id             String       @id @default(uuid())
  organizationId String
  credits        Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  type           String       @default("ai_images")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
}

/// A workspace's plan (Sprint 8 makes it live).
///
/// Inherited meanings kept: `identifier` is the Stripe subscription id,
/// `cancelAt` is when a scheduled cancellation ends access, `totalChannels` is
/// the channel entitlement, and `Organization.paymentId` is the Stripe customer
/// id. A 14-day trial is a row with `status = TRIALING` and `trialEndsAt`;
/// expiry is computed on read, never by a job. `lastStripeEventAt` is the
/// ordering guard: a webhook event older than it is ignored.
model Subscription {
  id                String             @id @default(cuid())
  organizationId    String             @unique
  subscriptionTier  SubscriptionTier
  identifier        String?
  cancelAt          DateTime?
  period            Period
  totalChannels     Int
  isLifetime        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  // --- Sprint 8 ------------------------------------------------------------
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd  DateTime?
  trialEndsAt       DateTime?
  /// A downgrade waiting for the period end, shown as "scheduled" until then.
  scheduledTier     SubscriptionTier?
  scheduledPeriod   Period?
  lastStripeEventAt DateTime?
  organization      Organization       @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([deletedAt])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  orgId        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  organization Organization  @relation(fields: [orgId], references: [id])
  integrations Integration[]

  @@unique([orgId, name, deletedAt])
}

model Integration {
  id                    String                 @id @default(cuid())
  internalId            String
  organizationId        String
  name                  String
  picture               String?
  providerIdentifier    String
  type                  String
  token                 String
  disabled              Boolean                @default(false)
  tokenExpiration       DateTime?
  refreshToken          String?
  profile               String?
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime?              @updatedAt
  inBetweenSteps        Boolean                @default(false)
  refreshNeeded         Boolean                @default(false)
  postingTimes          String                 @default("[{\"time\":120}, {\"time\":400}, {\"time\":700}]")
  customInstanceDetails String?
  customerId            String?
  rootInternalId        String?
  additionalSettings    String?                @default("[]")
  // UI revamp (2026-10-19): the avatar palette slot the channel's initials are
  // drawn in, 0-based, as handed to the web's `colorSeed`. Stored rather than
  // computed so changing the palette later never repaints existing channels
  // and an admin can pick a colour. Assigned on connect; see
  // apps/api/src/modules/channels/channel-colors.ts.
  color                 Int?
  // UI revamp (2026-10-19): where the channel sits in the workspace's channel
  // list (the calendar's Channels card, pickers), 0 first. Admins reorder by
  // dragging; a new channel goes last. Null only on a row created outside the
  // channels repository, which then sorts after the rest by creation time.
  position              Int?
  customer              Customer?              @relation(fields: [customerId], references: [id])
  organization          Organization           @relation(fields: [organizationId], references: [id])
  webhooks              IntegrationsWebhooks[]
  posts                 Post[]
  // Sprint 7
  channelMetrics        ChannelMetricSnapshot[]
  postMetrics           PostMetricSnapshot[]
  analyticsSync         AnalyticsSync?

  @@unique([organizationId, internalId])
  @@index([rootInternalId])
  @@index([organizationId])
  @@index([providerIdentifier])
  @@index([updatedAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([customerId])
  @@index([inBetweenSteps])
  @@index([refreshNeeded])
  @@index([disabled])
}

model Signatures {
  id             String       @id @default(uuid())
  organizationId String
  content        String
  autoAdd        Boolean
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
  @@index([organizationId])
  @@index([deletedAt])
}

model Comments {
  id             String       @id @default(uuid())
  content        String
  organizationId String
  postId         String
  userId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  post           Post         @relation(fields: [postId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([organizationId])
  @@index([userId])
  @@index([postId])
  @@index([deletedAt])
}

model Post {
  id                         String                    @id @default(cuid())
  state                      State                     @default(QUEUE)
  publishDate                DateTime
  organizationId             String
  integrationId              String
  content                    String
  delay                      Int                       @default(0)
  group                      String
  title                      String?
  description                String?
  parentPostId               String?
  releaseId                  String?
  releaseURL                 String?
  settings                   String?
  image                      String?
  creationMethod             CreationMethod            @default(UNKNOWN)
  intervalInDays             Int?
  error                      String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  deletedAt                  DateTime?
  comments                   Comments[]
  errors                     Errors[]
  integration                Integration               @relation(fields: [integrationId], references: [id])
  organization               Organization              @relation(fields: [organizationId], references: [id])
  parentPost                 Post?                     @relation("parentPostId", fields: [parentPostId], references: [id])
  childrenPost               Post[]                    @relation("parentPostId")
  tags                       TagsPosts[]
  // Sprint 7
  metrics                    PostMetricSnapshot[]

  @@index([group])
  @@index([deletedAt])
  @@index([publishDate])
  @@index([state])
  @@index([organizationId])
  @@index([parentPostId])
  @@index([intervalInDays])
  @@index([creationMethod])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([releaseURL])
  @@index([integrationId])
}

/// An in-app notification, scoped to the workspace (every member sees it).
///
/// Sprint 8 made the row an **outbox** as well: whoever writes an event sets
/// `emailStatus = PENDING`, and the API's dispatcher sends the email through
/// the one mail path and marks the outcome. `type` is the catalogue in
/// `apps/api/src/modules/notifications/notifications.types.ts`; `meta` holds
/// what an email needs beyond `content` (post group, channel, reason).
model Notifications {
  id             String                  @id @default(uuid())
  organizationId String
  content        String
  link           String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?
  // --- Sprint 8 ------------------------------------------------------------
  type           String                  @default("info")
  title          String?
  meta           Json?
  emailStatus    NotificationEmailStatus @default(NONE)
  emailedAt      DateTime?
  organization   Organization            @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([emailStatus])
}

enum NotificationEmailStatus {
  NONE
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

/// Where one user has read up to in one workspace's notifications.
///
/// Per (user, workspace) rather than one timestamp on the user, so reading
/// workspace A never clears workspace B's badge. No row means "unread is
/// everything newer than the membership", so a new member does not inherit a
/// backlog and an old one does not lose it.
model NotificationCursor {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model IntegrationsWebhooks {
  integrationId String
  webhookId     String
  integration   Integration @relation(fields: [integrationId], references: [id])
  webhook       Webhooks    @relation(fields: [webhookId], references: [id])

  @@id([integrationId, webhookId])
  @@unique([integrationId, webhookId])
  @@index([integrationId])
  @@index([webhookId])
}

/// An outbound webhook: a URL the workspace wants post events delivered to.
///
/// `secret` is the HMAC-SHA256 signing secret, stored as AES-256-GCM
/// ciphertext (packages/db crypto) because the worker has to sign with the
/// plaintext; the UI only ever sees it at creation and on rotation. `events`
/// is the subset of the catalogue this hook subscribes to; `integrations`
/// (inherited join table) narrows it to particular channels, empty meaning all.
model Webhooks {
  id             String                 @id @default(uuid())
  name           String
  organizationId String
  url            String
  deletedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  // --- Sprint 8 ------------------------------------------------------------
  secret         String                 @default("")
  events         String[]               @default(["post.published", "post.failed"])
  disabled       Boolean                @default(false)
  integrations   IntegrationsWebhooks[]
  deliveries     WebhookDelivery[]
  organization   Organization           @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([deletedAt])
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

/// One attempt-series to deliver one event to one webhook.
///
/// `deliveryKey` (`<webhookId>:<event>:<subjectId>`) is unique, so a re-run of
/// the activity that created it finds the row rather than enqueueing a second
/// delivery of the same occurrence. The worker's `webhookDeliveryWorkflow`
/// owns the row from PENDING to DELIVERED or FAILED.
model WebhookDelivery {
  id             String                @id @default(uuid())
  organizationId String
  webhookId      String
  event          String
  deliveryKey    String                @unique
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastStatusCode Int?
  /// Safe to show: a status line, never the receiver's body.
  lastError      String?
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  webhook        Webhooks              @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@index([webhookId, createdAt])
}

/// A public API key (Sprint 8). Several per workspace, so one integration can
/// be rotated or revoked without breaking the others.
///
/// Only `keyHash` (SHA-256 of the secret) is stored; the secret is shown once
/// at creation. SHA-256 rather than argon2 because the secret is 30 bytes of
/// CSPRNG output with no dictionary to slow down, and the column has to be
/// searchable by equality, the same reasoning as the User token hashes.
/// `prefix` (`pg_` + 8 chars) lets a person tell keys apart in the UI and in
/// a leaked log without revealing anything usable.
model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  prefix         String
  keyHash        String       @unique
  createdById    String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// A Stripe event that has been processed: the webhook's idempotency table.
///
/// The primary key *is* the Stripe event id, so inserting it inside the same
/// transaction as the state change makes a replayed event a unique-constraint
/// failure rather than a second application. In simulation the id is
/// `sim_<uuid>`, and the handler is the same.
model BillingEvent {
  id             String        @id
  type           String
  organizationId String?
  /// `applied`, or `ignored:<reason>` (unhandled type, stale, unknown customer…).
  outcome        String
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Sets {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Errors {
  id             String       @id @default(uuid())
  message        String
  platform       String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  postId         String
  body           String       @default("{}")
  organization   Organization @relation(fields: [organizationId], references: [id])
  post           Post         @relation(fields: [postId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
}

model OAuthApp {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  pictureId      String?
  redirectUrl    String
  clientId       String               @unique
  clientSecret   String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  organization   Organization         @relation(fields: [organizationId], references: [id])
  picture        Media?               @relation(fields: [pictureId], references: [id])
  authorizations OAuthAuthorization[]

  @@unique([organizationId, deletedAt])
  @@index([clientId])
  @@index([organizationId])
  @@index([deletedAt])
}

model OAuthAuthorization {
  id                String       @id @default(uuid())
  oauthAppId        String
  userId            String
  organizationId    String
  accessToken       String?
  authorizationCode String?
  codeExpiresAt     DateTime?
  revokedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  oauthApp          OAuthApp     @relation(fields: [oauthAppId], references: [id])
  user              User         @relation(fields: [userId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@unique([oauthAppId, userId, organizationId])
  @@index([accessToken])
  @@index([authorizationCode])
  @@index([oauthAppId])
  @@index([userId])
  @@index([organizationId])
  @@index([revokedAt])
}

enum State {
  QUEUE
  PUBLISHED
  ERROR
  DRAFT
}

enum SubscriptionTier {
  STANDARD
  PRO
  TEAM
  ULTIMATE
}

enum Period {
  MONTHLY
  YEARLY
}

enum Provider {
  LOCAL
  FACEBOOK
  GOOGLE
  FARCASTER
  WALLET
  GENERIC
}

/// UI revamp (2026-10-17). SYSTEM follows the device's prefers-color-scheme:
/// the default, as most SaaS apps do; LIGHT/DARK are explicit overrides.
enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

// --- Sprint 2: onboarding survey ------------------------------------------
// One enum per question, so the answer set is enforced by the database rather
// than only by the Zod schema in front of it. Values that begin with a digit
// are prefixed (SIZE_2_10) because Prisma enum members cannot start with one.

/// Q1: "How would you describe yourself?" Eight answers since 2026-10-20
/// (Buffer's onboarding): FREELANCER, NONPROFIT and FOUNDER were added; the
/// first five keep their names so stored answers stay valid.
enum OnboardingRole {
  SOLO_CREATOR
  AGENCY
  IN_HOUSE_TEAM
  SMALL_BUSINESS
  OTHER
  FREELANCER
  NONPROFIT
  FOUNDER
}

/// Q2: "How big is your team?"
enum OnboardingTeamSize {
  JUST_ME
