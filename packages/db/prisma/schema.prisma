// ---------------------------------------------------------------------------
// Sprint 7: analytics (PRD 5.6) and SEO score prediction (PRD 5.7).
//
// PostGear's own models, added per Sprint 1's rule: uuid ids, `organizationId`
// scoping, `createdAt`/`updatedAt`. All four hold *derived* data (platform
// metrics, crawl results) that can be regenerated, so they cascade with the
// rows they describe rather than carrying a soft delete; every read still
// scopes on the organization.
// ---------------------------------------------------------------------------

/// One day of one metric for one channel, as the platform reported it.
///
/// Keyed on (channel, metric, day) so a re-sync overwrites rather than
/// duplicates, and so a 90-day chart is one range query. `value` is a Float
/// because a few platforms report averages (watch time, view percentage), and
/// counts fit in it exactly up to 2^53.
model ChannelMetricSnapshot {
  id             String       @id @default(uuid())
  organizationId String
  integrationId  String
  /// The UTC day the value belongs to.
  date           DateTime     @db.Date
  /// One of `CHANNEL_METRIC_NAMES` in @postgear/social-core.
  metric         String
  value          Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, metric, date])
  @@index([organizationId, date])
  @@index([integrationId, date])
}

/// A published post's lifetime metrics at the moment they were read.
///
/// Append-only: every sync adds a row, so a post's engagement can be shown
/// over time and the latest row is "now". `postId` is the root row of one
/// channel's chain (the row that carries `releaseId`), per posts.repository.ts.
model PostMetricSnapshot {
  id             String       @id @default(uuid())
  organizationId String
  postId         String
  integrationId  String
  capturedAt     DateTime     @default(now())
  likes          Int          @default(0)
  comments       Int          @default(0)
  shares         Int          @default(0)
  clicks         Int          @default(0)
  impressions    Int          @default(0)
  saves          Int          @default(0)
  views          Int          @default(0)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post           Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([organizationId, capturedAt])
  @@index([postId, capturedAt])
  @@index([integrationId, capturedAt])
}

enum AnalyticsSyncStatus {
  NEVER
  OK
  FAILED
  UNSUPPORTED
  NEEDS_RECONNECT
  NEEDS_PERMISSIONS
}

/// Where one channel's metrics sync stands, written by the worker's
/// analytics workflow, read by the Analytics page's status row.
model AnalyticsSync {
  id             String              @id @default(uuid())
  organizationId String
  integrationId  String              @unique
  status         AnalyticsSyncStatus @default(NEVER)
  lastSyncedAt   DateTime?
  lastAttemptAt  DateTime?
  /// A message already safe to show, never a provider response body.
  lastError      String?
  /// What the last successful sync wrote, for the status row.
  channelDays    Int                 @default(0)
  postsSynced    Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    Integration         @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum SEOAuditStatus {
  PENDING
  CRAWLING
  SCORING
  ADVISING
  DONE
  FAILED
}

/// One run of the SEO analyzer against one URL.
///
/// Written progressively as the run moves through its stages, so a crash
/// mid-run leaves a row that says how far it got rather than nothing. The
/// four sub-scores are columns so the history and trend queries never open
/// the JSON; `auditData` holds the crawl and every check, `aiAdvice` the
/// prioritised recommendations.
model SEOAudit {
  id             String         @id @default(uuid())
  organizationId String
  /// The URL as submitted, normalised (scheme, host lower-cased, no fragment).
  targetUrl      String
  /// Where the crawl ended up after redirects.
  finalUrl       String?
  status         SEOAuditStatus @default(PENDING)
  /// Safe to show. Set only when `status` is FAILED.
  failureReason  String?
  overallScore   Int?
  grade          String?
  onPageScore    Int?
  technicalScore Int?
  contentScore   Int?
  backlinkScore  Int?
  /// "browser" (headless Chromium) or "html" (plain fetch fallback).
  crawlMode      String?
  durationMs     Int?
  auditData      Json?
  aiAdvice       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  completedAt    DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, targetUrl, createdAt])
}

// ===========================================================================
// Sprint 9: Design Studio
// ===========================================================================

/// How a brand kit's colours and logo were obtained.
enum BrandKitSource {
  MANUAL
  EXTRACTED
}

/// The four shapes a design can be exported at. Mirrors `FormatId` in
/// `@postgear/design-engine`; the Zod schema on the API maps between the two,
/// and `studio.schema.spec.ts` asserts that the mapping is total.
enum DesignFormat {
  SQUARE
  PORTRAIT
  STORY
  LANDSCAPE
}

/// Where a design has got to. `EXPORTED` means its slides are Media rows,
/// `SENT` that a draft post was created from them.
enum DesignStatus {
  DRAFT
  EXPORTED
  SENT
}

/// One brand's name, logo and colours.
///
/// Several per workspace, because an agency runs a kit per client and must
/// never be able to put one client's logo on another's post. Editing a kit
/// changes new designs only: a design copies the five colours into its own
/// document when the kit is applied, and the editor offers Update Colours
/// rather than rewriting work somebody already approved.
model BrandKit {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  /// As submitted, normalised. Kept so Extract From Website can be re-run.
  websiteUrl     String?
  logoMediaId    String?
  /// `BrandColors` from the design engine: primary, secondary, accent,
  /// background and text, each a `#RRGGBB`. A JSON column rather than five
  /// text columns because the engine's Zod schema is the real contract, and
  /// five nullable columns would let half a palette exist.
  colors         Json
  /// Sprint 9b: the kit's own fonts, as `FontId`s from the design engine;
  /// null keeps the theme's. Plain strings rather than an enum because the
  /// font library is code and grows without a migration; the API checks
  /// every id against the engine's list.
  headingFont    String?
  bodyFont       String?
  /// Sprint 9b: while this kit is applied to a design, its colours, logo and
  /// fonts are the kit's alone; the editor hides the controls that would
  /// change them.
  lockLook       Boolean        @default(false)
  /// Sprint 9b: what a new design's closing slide asks for, and where it
  /// points.
  ctaText        String?
  ctaUrl         String?
  source         BrandKitSource @default(MANUAL)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logo           Media?         @relation("BrandKitLogo", fields: [logoMediaId], references: [id])
  createdBy      User?          @relation("BrandKitAuthor", fields: [createdById], references: [id])
  designs        Design[]

  @@index([organizationId, deletedAt, updatedAt])
}

/// One user's design: a single post or a carousel.
///
/// The slides live inside `document`, not in a `DesignSlide` table. Two
/// reasons: a design is edited and saved as one unit (the autosave writes the
/// whole thing 1.5 s after the last keystroke, and a dozen tiny row writes per
/// pause would be the slowest part of the editor), and the shape is already
/// defined and versioned by `designDocumentSchema` in
/// `@postgear/design-engine`, which validates every write. The column is a
/// value, not a bag: nothing reads it without parsing it.
///
/// `revision` is the optimistic lock. The editor sends the revision it loaded;
/// a mismatch is a 409 and that tab is told to reload, so two tabs cannot
/// silently overwrite each other.
model Design {
  id                   String        @id @default(uuid())
  organizationId       String
  title                String
  format               DesignFormat
  /// The preset it was created from, or "blank". Not a foreign key: templates
  /// are data in code, versioned with git, and never database rows.
  presetId             String
  brandKitId           String?
  document             Json
  /// Bumped on every accepted write. Starts at 1.
  revision             Int           @default(1)
  status               DesignStatus  @default(DRAFT)
  /// Media ids, one per slide, in slide order, from the last export.
  exportedMediaIds     String[]      @default([])
  /// The `revision` those media were rendered from. A design edited since is
  /// re-exported before Send rather than sending stale pictures.
  lastExportedRevision Int?
  /// The slide the editor was last on, so reopening lands where work stopped.
  lastSlideIndex       Int           @default(0)
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandKit             BrandKit?     @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  createdBy            User?         @relation("DesignAuthor", fields: [createdById], references: [id])
  shares               DesignShare[]

  @@index([organizationId, deletedAt, updatedAt])
  @@index([organizationId, format])
}

/// A read-only link to a design, for someone without an account.
///
/// Only the hash is stored, the same rule as activation and reset tokens: a
/// database leak yields no working link. The token is shown once, when it is
/// created.
model DesignShare {
  id           String    @id @default(uuid())
  designId     String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
  design       Design    @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdBy    User?     @relation("DesignShareAuthor", fields: [createdById], references: [id])

  @@index([designId, revokedAt])
}

/// A template somebody on the team starred, so the gallery's Favourites filter
/// is shared across the workspace rather than living in one browser.
///
/// `presetId` is a string from the code-side library, not a foreign key, for
/// the same reason `Design.presetId` is: there is no templates table.
model DesignFavourite {
  id             String       @id @default(uuid())
  organizationId String
  presetId       String
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("DesignFavouriteAuthor", fields: [createdById], references: [id])

  @@unique([organizationId, presetId])
}

// ===========================================================================
// Sprint 10: Workflow Builder (the UI says Workflow and Step; the code says
// Automation and node)
// ===========================================================================

/// Draft, on or paused. A paused workflow keeps its active version.
enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

/// A test runs the draft with outside effects dry; a live run is the real
/// thing, from the active version.
enum AutomationRunMode {
  TEST
  LIVE
}

/// `REJECTED` (a Manual Review said no) and `EXPIRED` (nobody reviewed in
/// time) are outcomes, not failures: only `FAILED` counts towards alerts and
/// the auto-pause.
enum AutomationRunStatus {
  QUEUED
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
  REJECTED
  EXPIRED
}

/// One step's state in one run. `DRY_RUN` is a test that stood in for an
/// outside effect; `HANDLED_ERROR` failed but its On Error setting carried on.
enum AutomationStepStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  DRY_RUN
  HANDLED_ERROR
  FAILED
  SKIPPED
  WAITING
  CANCELLED
}

/// One workflow: a trigger and the steps after it.
///
/// The draft is one JSON value (`AutomationGraph` from
/// `@postgear/automation`), the same reasoning as `Design.document`: the
/// builder autosaves the whole graph, and the package's Zod schema validates
/// every write. `draftRevision` is the optimistic lock, as in Studio.
///
/// Turning a workflow on snapshots the draft into an `AutomationVersion`;
/// live runs only ever read a version, never the draft.
model Automation {
  id                    String               @id @default(uuid())
  organizationId        String
  /// "Untitled Workflow" unless named.
  name                  String
  status                AutomationStatus     @default(DRAFT)
  draftGraph            Json
  /// Bumped on every accepted write. Starts at 1.
  draftRevision         Int                  @default(1)
  /// Test data pinned per step: `{ [nodeKey]: { output, pinnedAt, pinnedById } }`.
  /// On the row, not in the graph, so versions never carry it and live runs
  /// cannot read it. Redacted and capped before it is stored.
  pinnedData            Json                 @default("{}")
  activeVersionId       String?              @unique
  /// True when an active or paused workflow's draft differs from its active
  /// version (the list's Unpublished Changes badge).
  hasUnpublishedChanges Boolean              @default(false)
  /// Copied from the draft's trigger (`trigger.postPublished`) for the list.
  triggerType           String?
  lastRunAt             DateTime?
  lastRunStatus         AutomationRunStatus?
  /// One sentence, for the list's hover.
  lastRunError          String?
  /// Live runs only. Module 09 pauses the workflow at 5 in a row.
  consecutiveFailures   Int                  @default(0)
  /// The starter template it came from, if any. Templates are code, so this
  /// is plain text, not a foreign key.
  templateId            String?
  createdById           String?
  updatedById           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeVersion         AutomationVersion?   @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  createdBy             User?                @relation("AutomationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy             User?                @relation("AutomationEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  versions              AutomationVersion[]  @relation("AutomationVersions")
  runs                  AutomationRun[]

  @@index([organizationId, deletedAt, updatedAt])
  @@index([organizationId, status])
}

/// An immutable snapshot of a workflow, made when it is turned on. Never
/// updated after insert.
model AutomationVersion {
  id           String          @id @default(uuid())
  automationId String
  version      Int
  graph        Json
  triggerType  String
  /// Optional, typed in the activation dialog.
  note         String?
  createdById  String?
  createdAt    DateTime        @default(now())
  automation   Automation      @relation("AutomationVersions", fields: [automationId], references: [id], onDelete: Cascade)
  activeFor    Automation?     @relation("ActiveVersion")
  createdBy    User?           @relation("AutomationVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  runs         AutomationRun[]

  @@unique([automationId, version])
}

/// One run of a workflow, test or live.
model AutomationRun {
  id             String              @id @default(uuid())
  automationId   String
  /// Null only for draft test runs.
  versionId      String?
  organizationId String
  mode           AutomationRunMode
  status         AutomationRunStatus @default(QUEUED)
  triggerType    String
  /// Dedupes trigger events ("post.published:<rootPostId>", Module 09).
  /// Null for manual and test runs; Postgres lets many nulls share the
  /// unique index.
  triggerEventId String?
  /// Redacted and capped.
  triggerPayload Json
  /// Test runs only: the draft as it was when the test started.
  graphSnapshot  Json?
  /// Step tests only: upstream outputs the tested step reads, `{ [nodeKey]: output }`
  /// (pinned data, else the last test run, else samples). Redacted and capped.
  seedOutputs    Json?
  /// Test runs: `AutomationRunOptions` from `@postgear/scheduling`
  /// (`{ scope, sendForReal, triggerData }`). Null for live runs.
  options        Json?
  /// Manual and test runs.
  startedById    String?
  creditsUsed    Int                 @default(0)
  stepCount      Int                 @default(0)
  /// One sentence.
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime            @default(now())
  automation     Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  version        AutomationVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startedBy      User?               @relation("AutomationRunStarter", fields: [startedById], references: [id], onDelete: SetNull)
  steps          AutomationRunStep[]

  @@unique([automationId, triggerEventId])
  @@index([automationId, createdAt])
  @@index([organizationId, status])
  // Reconcile and prune.
  @@index([status, createdAt])
}

/// One step's attempt in one run. Name and type are copied in, so a step
/// renamed or deleted since still reads correctly in old runs.
model AutomationRunStep {
  id         String               @id @default(uuid())
  runId      String
  nodeKey    String
  nodeType   String
  nodeName   String
  status     AutomationStepStatus
  attempt    Int                  @default(1)
  /// Redacted, capped at 64 KB.
  input      Json?
  /// Redacted, capped at 64 KB.
  output     Json?
  truncated  Boolean              @default(false)
  /// `{ message, code, retryable, details? }`.
  error      Json?
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  run        AutomationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeKey, attempt])
  // Live run polling (Module 07).
  @@index([runId, updatedAt])
}

/// `NEEDS_RECONNECT` is set when the app refused the stored credentials (a
/// 401, 403 or 404, or a revoked Google token); `ERROR` when a check failed
/// for another reason.
enum AutomationConnectionStatus {
  CONNECTED
  NEEDS_RECONNECT
  ERROR
}

/// An outside app linked to a workspace once (a Slack or Discord link, a
/// Teams Workflows link, secret HTTP headers, a Google account) and picked by
/// any workflow. A step's config holds only the id.
///
/// `credentials` is the one encrypted column: the provider's validated
/// credentials as one JSON value through `encrypt()`, never returned and
/// never logged. `maskedHint` and `meta` are safe to show.
///
/// "Used by N workflows" is scanned from the graphs, not stored (see
/// SCHEMA_NOTES.md). Names are unique per workspace and app among rows that
/// are not deleted, checked by the API.
model AutomationConnection {
  id             String                     @id @default(uuid())
  organizationId String
  /// 'slack' | 'teams' | 'discord' | 'http' | 'google'.
  provider       String
  /// "Marketing Slack".
  name           String
  /// encrypt(JSON.stringify(credentials)).
  credentials    String
  /// "hooks.slack.com/...a9F2", computed once at save.
  maskedHint     String
  status         AutomationConnectionStatus @default(CONNECTED)
  lastCheckedAt  DateTime?
  /// One sentence, safe to show.
  lastError      String?
  /// Non-secret extras (the Google account email).
  meta           Json?
  createdById    String?
  updatedById    String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  deletedAt      DateTime?
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?                      @relation("AutomationConnectionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?                      @relation("AutomationConnectionEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([organizationId, provider, deletedAt])
}
