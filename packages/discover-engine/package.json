{
  "name": "@postgear/discover-engine",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "biome lint ./src ./scripts",
    "lint:fix": "biome check --write ./src ./scripts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "languages": "ts-node scripts/generate-languages.ts && biome format --write src/geo/languages.generated.ts",
    "fixtures": "ts-node scripts/record-fixtures.ts",
    "print-feed": "ts-node scripts/print-feed.ts",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "countries-and-timezones": "^3.11.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "cldr-core": "^49.0.0",
    "typescript": "^5.5.0"
  }
}
