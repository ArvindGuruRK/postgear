{
  "name": "@postgear/media-contract",
  "version": "0.0.1",
  "private": true,
  "description": "The shapes that cross between the Node worker and the Python media service, written once.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./names": "./src/names.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome lint ./src ./scripts",
    "lint:fix": "biome check --write ./src ./scripts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "contract:export": "ts-node --transpile-only --project ../../scripts/tsconfig.json scripts/export.ts",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@postgear/storage": "*",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
