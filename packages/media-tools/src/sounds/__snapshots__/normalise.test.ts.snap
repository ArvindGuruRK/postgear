// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`the FFmpeg arguments encodes AAC-LC 128 kbps, 48 kHz, two channels, .m4a, with the gain, 5 ms fades and no tags 1`] = `
[
  "-hide_banner",
  "-nostdin",
  "-y",
  "-loglevel",
  "error",
  "-format_whitelist",
  "mp3,wav,mov,mp4,m4a,3gp,3g2,mj2,aac,ogg,flac",
  "-protocol_whitelist",
  "file",
  "-i",
  "file:x.trimmed.wav",
  "-vn",
  "-sn",
  "-dn",
  "-af",
  "aresample=48000,volume=-4.26dB,afade=t=in:st=0:d=0.005,afade=t=out:st=1.495:d=0.005",
  "-map_metadata",
  "-1",
  "-map_chapters",
  "-1",
  "-c:a",
  "aac",
  "-b:a",
  "128k",
  "-ar",
  "48000",
  "-ac",
  "2",
  "-fflags",
  "+bitexact",
  "-flags:a",
  "+bitexact",
  "-movflags",
  "+faststart",
  "-f",
  "ipod",
  "out.m4a",
]
`;

exports[`the FFmpeg arguments trims silence at both ends into a float WAV, safely 1`] = `
[
  "-hide_banner",
  "-nostdin",
  "-y",
  "-loglevel",
  "error",
  "-format_whitelist",
  "mp3,wav,mov,mp4,m4a,3gp,3g2,mj2,aac,ogg,flac",
  "-protocol_whitelist",
  "file",
  "-i",
  "file:in.ogg",
  "-vn",
  "-sn",
  "-dn",
  "-af",
  "pan=stereo|c0=c0|c1=c0,aresample=48000,aformat=sample_fmts=flt,silenceremove=start_periods=1:start_threshold=-60dB:start_silence=0.02,areverse,silenceremove=start_periods=1:start_threshold=-60dB:start_silence=0.02,areverse",
  "-map_metadata",
  "-1",
  "-c:a",
  "pcm_f32le",
  "-f",
  "wav",
  "x.trimmed.wav",
]
`;
