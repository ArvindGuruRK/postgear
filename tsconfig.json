{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@postgear/db": ["packages/db/src"],
      "@postgear/social-core": ["packages/social-core/src"],
      "@postgear/seo-engine": ["packages/seo-engine/src"],
      "@postgear/ai-engine": ["packages/ai-engine/src"],
      "@postgear/ui": ["packages/ui/src"],
      "@postgear/config": ["packages/config"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
